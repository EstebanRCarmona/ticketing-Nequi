@startuml orders_flow
!theme plain
skinparam backgroundColor #FAFAFA
skinparam roundcorner 8
skinparam sequenceArrowThickness 2
skinparam sequenceParticipantBorderColor #555
skinparam sequenceLifeLineBorderColor #999

title Orders API — High-Level Flow

actor       "Client"           as C
participant "OrderHandler"     as H
participant "UseCase"          as UC
participant "DynamoDB"         as DB
participant "Seat records"     as SEATS
participant "SQS"              as SQS
participant "SQS Consumer"     as CONS

== 1. Reserve (POST /api/v1/orders) ==
C -> H : POST /api/v1/orders\n{ eventId, seatIds[] }
H -> UC : CreateOrderUseCase
UC -> SEATS : Get selected seat records
SEATS --> UC : status AVAILABLE
UC -> DB : TransactWriteItems\n(order + inventory + idempotency + history)
UC -> SEATS : Conditional updates\nAVAILABLE → RESERVED\n[in same transaction]
UC -> SQS : sendExpireOrderMessage (delay 10 min)
DB --> C : 201 { orderId, seatIds, status: RESERVED, expiresAt }

== 2. Confirm (POST /api/v1/orders/{id}/confirm) ==
C -> H : POST /api/v1/orders/{id}/confirm\n{ paymentReference }
H -> UC : ConfirmOrderUseCase
UC -> DB : UpdateItem → PENDING_CONFIRMATION\n[optimistic lock: version]
UC -> SEATS : Conditional update\nRESERVED → PENDING_CONFIRMATION
UC -> SQS : sendFinalizeOrderMessage
DB --> C : 202 { orderId, status: PENDING_CONFIRMATION }

== 3. Async Payment (SQS Consumer) ==
SQS -> CONS : FINALIZE_ORDER message
CONS -> UC : ProcessOrderAsyncUseCase
UC -> DB : TransactWriteItems\norder + inventory + seat states + history\n[optimistic lock + expected seat status]
CONS -> SEATS : PENDING_CONFIRMATION → SOLD\nOR AVAILABLE on payment rejection
DB --> CONS : ack → deleteMessage

== 4. Cancel (POST /api/v1/orders/{id}/cancel) ==
C -> H : POST /api/v1/orders/{id}/cancel\n{ reason }
H -> UC : CancelOrderUseCase
UC -> DB : TransactWriteItems\norder CANCELLED + inventory + history
UC -> SEATS : RESERVED → AVAILABLE\n[in same transaction]
DB --> C : 200 { orderId, status: CANCELLED }

== 5. Expiration (automatic) ==
SQS -> CONS : EXPIRE_ORDER message (after 10 min)
CONS -> UC : ReleaseExpiredReservationsUseCase
UC -> SEATS : RESERVED/PENDING_CONFIRMATION → AVAILABLE\n[in same transaction]

note over DB
  Scheduler sweeper runs every 60s
  as belt-and-suspenders fallback
  for any missed SQS expirations
end note

== 6. Get Order / History ==
C -> H : GET /api/v1/orders/{id}
H -> UC : GetOrderUseCase
UC -> DB : GetItem order
DB --> C : 200 { orderId, seatIds, status, expiresAt? }

C -> H : GET /api/v1/orders/{id}/history
H -> UC : GetOrderHistoryUseCase
UC -> DB : Query history table
DB --> C : 200 [ { sequence, fromStatus, toStatus, ... } ]

@enduml
